{
  "name": "bilibili-recorder",
  "version": "1.0.0",
  "description": "一个基于 Node.js + TypeScript 的 Bilibili 直播录制器，支持分片重试、任务队列、断点时间写入与自动合成 MP4。",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node-esm src/main.ts",
    "clean": "rimraf dist output/temp output/logs"
  },
  "author": "komori",
  "license": "MIT",
  "dependencies": {
    "@types/bun": "^1.3.4",
    "@types/fast-crc32c": "^2.0.2",
    "axios": "^1.7.7",
    "chalk": "^5.6.2",
    "crc-32": "^1.2.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "p-limit": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
