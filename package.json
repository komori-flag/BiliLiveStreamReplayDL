{
  "name": "bilibili-recorder",
  "version": "1.0.0",
  "description": "一个基于 Node.js + TypeScript 的 Bilibili 直播录制器，支持分片重试、任务队列、断点时间写入与自动合成 MP4。",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-esm src/index.ts",
    "clean": "rimraf dist output/temp output/logs"
  },
  "author": "komori",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
